{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["es2017", "dom"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types", "./node_modules/@figma/plugin-typings"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
